{
  "name": "Review",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "number",
      "description": "Total time the review run took, across both passes (model pass plus verifier pass)."
    },
    "modelUsed": {
      "type": "string"
    },
    "extractedFacts": {
      "type": "array",
      "description": "One object per fact the reviewer read out of the record: element, value, source.",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "flags": {
      "type": "array",
      "description": "One object per problem that survived the code checks and the verifier pass, plus the officer's disposition of it.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "MISSING",
              "INCONSISTENT",
              "UNCLEAR",
              "CITATION"
            ]
          },
          "element": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "Critical",
              "Major",
              "Minor"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "Open",
              "Fixed",
              "Dismissed",
              "Sent to supervisor"
            ],
            "default": "Open",
            "description": "The officer's action on this flag. NarrativeCheck never acts on a flag itself."
          },
          "dispositionReason": {
            "type": "string",
            "description": "Why the officer dismissed the flag."
          },
          "dispositionBy": {
            "type": "string"
          },
          "dispositionAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "citationCheck": {
      "type": "object",
      "description": "How the charge as written stands against the facts and the reference record.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "LIKELY MISMATCH",
            "CANNOT DETERMINE"
          ]
        },
        "chargeReviewed": {
          "type": "string"
        },
        "requiredFactsFound": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredFactsMissing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "humanReview": {
      "type": "object",
      "description": "Whether the record must go to a human reviewer, with plain-language reasons.",
      "properties": {
        "needed": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rawModelOutput": {
      "type": "string",
      "description": "Both passes for transparency: the model's first pass, the verifier's verdicts, what the code checks dropped or merged, and the flags the verifier rejected."
    }
  },
  "required": [
    "caseId"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}